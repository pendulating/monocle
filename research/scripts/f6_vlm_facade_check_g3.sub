#!/bin/bash
#SBATCH --clusters=g3
#SBATCH --partition=g3
#SBATCH --account=nissenbaum
#SBATCH --qos=nissenbaum
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH --time=04:00:00
#SBATCH --job-name=f6-facade-b300
#SBATCH -o /share/ju/matt/mllmsci/data/f6_restaurant_depiction/v4/logs/facade_b300_%j.out
#SBATCH -e /share/ju/matt/mllmsci/data/f6_restaurant_depiction/v4/logs/facade_b300_%j.err
# The F6 facade check (D63 to D69) on the B300 of g3. Same question and
# decoding as research/scripts/f6_vlm_facade_check.sub. The answers go to
# <selection dir>/facade_check_b300/ (v4 by default), so 1 folder holds the
# answers of 1 GPU type.
#
#   sbatch research/scripts/f6_vlm_facade_check_g3.sub
#
# The environment follows research/scripts/whatami/serve_and_query.sbatch, which ran
# gemma-4-12b on this GPU with vLLM 0.25.
set -euo pipefail
cd /share/ju/matt/mllmsci
mkdir -p /scratch/$USER/tmp
export TMPDIR=/scratch/$USER/tmp
export HF_HOME=/scratch/$USER/hf-home
export VLLM_CACHE_ROOT=/scratch/$USER/vllm-cache
export VLLM_CONFIG_ROOT=/scratch/$USER/vllm-config
export XDG_CACHE_HOME=/scratch/$USER/xdg-cache
export TRITON_CACHE_DIR=$TMPDIR/triton
export TORCHINDUCTOR_CACHE_DIR=$TMPDIR/inductor
export FLASHINFER_WORKSPACE_BASE=/scratch/$USER/flashinfer
export VLLM_NO_USAGE_STATS=1 VLLM_WORKER_MULTIPROC_METHOD=spawn TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True HF_HUB_OFFLINE=1 PYTHONUNBUFFERED=1
export IMAGE_FORWARD_DRIVER_VENV=/share/ju/matt/mllmsci/.venv-mllmsci-vllm025cu129
source "${IMAGE_FORWARD_DRIVER_VENV}/bin/activate"
source scripts/activate_stage_venv.sh
export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libstdc++.so.6
_site=$("${IMAGE_FORWARD_STAGE_PYTHON:-python}" -c 'import site; print(site.getsitepackages()[0])')
export FLASHINFER_EXTRA_CUDAFLAGS="-I$(readlink -f "$_site/nvidia/cublas/include")"
export FLASHINFER_EXTRA_CFLAGS="$FLASHINFER_EXTRA_CUDAFLAGS"
nvidia-smi -L || true
"${IMAGE_FORWARD_STAGE_PYTHON:-python}" research/scripts/f6_vlm_facade_check.py ask \
    --out-name facade_check_b300 --chunk 2048 --max-num-seqs 256 "$@"
