+// Readout instruments (monocle F10.35): layer loss, position loss and smear.
+//
+// The functions are pure: the tokens of a run, the layers of 1 lens column, the
+// selected tokens, the layer range and the optional rank block in, a word list
+// out. The list has the shape of the sidebar list, thus the panel shows it with
+// the same rows, select, highlight and steer.
+//
+// | Term     | Definition                                                     |
+// |----------|----------------------------------------------------------------|
+// | Salient  | In the top K words (K = 10) of a token at a layer              |
+// | Loss     | Salient at the start point and not salient at the end point    |
+// | Gain     | Not salient at the start point and salient at the end point    |
+//
+// The salient words come from `top_tokens` (the run holds the top 30). A rank
+// past the top 30 comes from the optional `instruments` key of the run (the rank
+// block of monocle `hop_viewer.py` 1.1.0). With no block, such a rank shows as
+// `>30`. The Python reference is `research/monocle/instruments.py` in monocle;
+// `jlens-instruments.test.ts` compares the 2 with a fixture.
+
+import { LensTokenMessage } from '@/lib/utils/lens';
+import type { CommonToken, LayerStat, TypeSidebar } from './jlens-analysis';
+import type { LayerRange } from './jlens-token-popup';
+
+export const INSTRUMENT_K = 10;
+export const INSTRUMENT_M = 3;
+
+export type InstrumentMode = 'count' | 'layerLoss' | 'positionLoss' | 'smear';
+// `one`: 1 token (layer loss) or 1 layer (position loss). `all`: all tokens or all layers.
+export type InstrumentVariant = 'one' | 'all';
+// The 2 measures of an `all` variant.
+export type InstrumentMeasure = 'salience' | 'lossGain';
+
+export type InstrumentState = {
+  mode: InstrumentMode;
+  variant: InstrumentVariant;
+  measure: InstrumentMeasure;
+  // Sort by the second value (not salient, or gain) and not by the first.
+  sortSecond: boolean;
+  // The layer of position loss, 1 layer. Null: the last layer of the range.
+  layer: number | null;
+  // Position loss: B to A, not A to B.
+  reverse: boolean;
+  // The shortest smear run.
+  m: number;
+};
+
+export const DEFAULT_INSTRUMENT: InstrumentState = {
+  mode: 'count',
+  variant: 'one',
+  measure: 'lossGain',
+  sortSecond: false,
+  layer: null,
+  reverse: false,
+  m: INSTRUMENT_M,
+};
+
+export type RankEntry = { w: number[]; r: number[][] };
+export type RankColumn = {
+  words: string[];
+  byPosition: Record<string, RankEntry>;
+  byLayer: Record<string, RankEntry & { positions: number[] }>;
+};
+export type InstrumentBlock = { version: number; unit: string; k: number; vocab: number; columns: Record<string, RankColumn> };
+
+// Give the block, or null when the value is absent or has a bad shape.
+export function parseInstrumentBlock(x: unknown): InstrumentBlock | null {
+  if (!x || typeof x !== 'object') {
+    return null;
+  }
+  const b = x as Partial<InstrumentBlock>;
+  if (b.unit !== 'rank' || !b.columns || typeof b.columns !== 'object') {
+    return null;
+  }
+  for (const c of Object.values(b.columns)) {
+    if (!c || !Array.isArray(c.words) || typeof c.byPosition !== 'object' || typeof c.byLayer !== 'object') {
+      return null;
+    }
+  }
+  return b as InstrumentBlock;
+}
+
+export type InstrumentRow = { key: string; token: string; value: number; label: string; stats: LayerStat[] };
+
+export type InstrumentOutput = {
+  rows: InstrumentRow[];
+  // The header of the value column and of the bar column.
+  valueHeader: string;
+  barHeader: string;
+  // 1 line that gives the instrument and its parameters.
+  describe: string;
+  // Why the list is empty (a selection is missing), or null.
+  note: string | null;
+};
+
+export type InstrumentInput = {
+  tokens: LensTokenMessage[];
+  type: string;
+  layers: number[];
+  range: LayerRange | null;
+  // The selected token positions, in prompt order.
+  selected: number[];
+  block: InstrumentBlock | null;
+  state: InstrumentState;
+  k?: number;
+};
+
+// The ranks of the block, by token and by layer, for 1 lens column.
+class RankLookup {
+  private col: RankColumn | undefined;
+
+  private pos = new Map<string, Map<string, number[]>>();
+
+  private lay = new Map<string, { at: Map<number, number>; ranks: Map<string, number[]> }>();
+
+  constructor(col: RankColumn | undefined) {
+    this.col = col;
+  }
+
+  // The rank of `word` at token `position` and layer index `li`, or null.
+  atPosition(position: number, li: number, word: string): number | null {
+    if (!this.col) {
+      return null;
+    }
+    const key = String(position);
+    let m = this.pos.get(key);
+    if (!m) {
+      m = new Map();
+      const e = this.col.byPosition[key];
+      if (e) {
+        e.w.forEach((w, i) => m!.set(this.col!.words[w], e.r[i]));
+      }
+      this.pos.set(key, m);
+    }
+    return m.get(word)?.[li] ?? null;
+  }
+
+  // The rank of `word` at layer `layer` and token `position`, or null.
+  atLayer(layer: number, position: number, word: string): number | null {
+    if (!this.col) {
+      return null;
+    }
+    const key = String(layer);
+    let m = this.lay.get(key);
+    if (!m) {
+      m = { at: new Map(), ranks: new Map() };
+      const e = this.col.byLayer[key];
+      if (e) {
+        e.positions.forEach((p, i) => m!.at.set(p, i));
+        e.w.forEach((w, i) => m!.ranks.set(this.col!.words[w], e.r[i]));
+      }
+      this.lay.set(key, m);
+    }
+    const j = m.at.get(position);
+    return j == null ? null : (m.ranks.get(word)?.[j] ?? null);
+  }
+}
+
+function slice(tok: LensTokenMessage | undefined, type: string) {
+  return tok?.results.find((r) => r.type === type);
+}
+
+// The salient words of a token at layer index `li`, or null when it has no read.
+function salientAt(tok: LensTokenMessage | undefined, type: string, li: number, k: number): string[] | null {
+  const row = slice(tok, type)?.top_tokens[li];
+  return row && row.length > 0 ? row.slice(0, k) : null;
+}
+
+// The rank of a word in the top list of the run (1 = top), or null when absent.
+function listRank(tok: LensTokenMessage | undefined, type: string, li: number, word: string): number | null {
+  const row = slice(tok, type)?.top_tokens[li];
+  const i = row ? row.indexOf(word) : -1;
+  return i >= 0 ? i + 1 : null;
+}
+
+function listLength(tok: LensTokenMessage | undefined, type: string, li: number): number {
+  return slice(tok, type)?.top_tokens[li]?.length ?? 0;
+}
+
+function rangeIndices(layers: number[], range: LayerRange | null): number[] {
+  return layers.map((_, i) => i).filter((i) => !range || (layers[i] >= range[0] && layers[i] <= range[1]));
+}
+
+// Per-layer bars: a value at each layer, as weight 0..1 against the largest value.
+function bars(layers: number[], value: (li: number) => number): LayerStat[] {
+  const v = layers.map((_, li) => value(li));
+  const max = Math.max(0, ...v);
+  return layers.map((layer, li) => ({ layer, weight: max > 0 ? v[li] / max : 0, count: v[li] }));
+}
+
+function rankLabel(r: number | null, n: number): string {
+  return r == null ? `>${n}` : String(r);
+}
+
+function sortRows(rows: InstrumentRow[]): InstrumentRow[] {
+  return rows.sort((a, b) => b.value - a.value || (a.key < b.key ? -1 : a.key > b.key ? 1 : 0));
+}
+
+function empty(valueHeader: string, barHeader: string, describe: string, note: string): InstrumentOutput {
+  return { rows: [], valueHeader, barHeader, describe, note };
+}
+
+// The salient sets of each token at layer index `li` (tokens with no read are absent).
+function setsAtLayer(tokens: LensTokenMessage[], type: string, li: number, k: number): Map<number, Set<string>> {
+  const out = new Map<number, Set<string>>();
+  for (const t of tokens) {
+    const s = salientAt(t, type, li, k);
+    if (s) {
+      out.set(t.position, new Set(s));
+    }
+  }
+  return out;
+}
+
+export function computeInstrument(input: InstrumentInput): InstrumentOutput {
+  const { tokens, type, layers, range, selected, block, state } = input;
+  const k = input.k ?? INSTRUMENT_K;
+  const lookup = new RankLookup(block?.columns[type]);
+  const idx = rangeIndices(layers, range);
+  const byPos = new Map(tokens.map((t) => [t.position, t] as const));
+  const sal = `salient = top ${k}`;
+  if (idx.length === 0) {
+    return empty('', '', '', 'The layer range holds no read layer.');
+  }
+  const X = idx[0];
+  const Y = idx[idx.length - 1];
+
+  if (state.mode === 'layerLoss' && state.variant === 'one') {
+    const head = ['Rank', 'Salient by layer'] as const;
+    if (selected.length !== 1) {
+      return empty(...head, 'Layer loss, 1 token', 'Select 1 token.');
+    }
+    if (idx.length < 2) {
+      return empty(...head, 'Layer loss, 1 token', 'Set the LAYERS slider to 2 or more layers.');
+    }
+    const tok = byPos.get(selected[0]);
+    const start = salientAt(tok, type, X, k);
+    const end = salientAt(tok, type, Y, k);
+    const describe = `Layer loss, 1 token (position ${selected[0]}), L${layers[X]} → L${layers[Y]}, ${sal}`;
+    if (!start || !end) {
+      return empty(...head, describe, 'This token has no read at these layers in this column.');
+    }
+    const endSet = new Set(end);
+    const n = listLength(tok, type, Y);
+    const rows = start
+      .map((w, i) => ({ w, s: i + 1 }))
+      .filter(({ w }) => !endSet.has(w))
+      .map(({ w, s }) => {
+        const e = lookup.atPosition(selected[0], Y, w) ?? listRank(tok, type, Y, w);
+        const stats = layers.map((layer, li) => {
+          const r = lookup.atPosition(selected[0], li, w) ?? listRank(tok, type, li, w);
+          return { layer, weight: r != null && r <= k ? 1 : 0, count: r ?? 0 };
+        });
+        return { key: w, token: w, value: e ?? Number.MAX_SAFE_INTEGER, label: `${s} → ${rankLabel(e, n)}`, stats, s };
+      })
+      .sort((a, b) => b.value - a.value || a.s - b.s)
+      .map(({ s: _s, ...row }) => row);
+    return { rows, valueHeader: head[0], barHeader: head[1], describe, note: null };
+  }
+
+  if (state.mode === 'layerLoss') {
+    const sets = layers.map((_, li) => setsAtLayer(tokens, type, li, k));
+    if (state.measure === 'salience') {
+      const describe = `Layer loss, all tokens, salience count at L${layers[X]}, ${sal}`;
+      const at = sets[X];
+      const count = new Map<string, number>();
+      for (const s of at.values()) {
+        for (const w of s) {
+          count.set(w, (count.get(w) ?? 0) + 1);
+        }
+      }
+      const rows = [...count.entries()].map(([w, c]) => ({
+        key: w,
+        token: w,
+        value: state.sortSecond ? at.size - c : c,
+        label: `${c} / ${at.size - c}`,
+        stats: bars(layers, (li) => [...sets[li].values()].filter((s) => s.has(w)).length),
+      }));
+      return { rows: sortRows(rows), valueHeader: 'Salient / not', barHeader: 'Salient count by layer', describe, note: null };
+    }
+    const describe = `Layer loss, all tokens, loss and gain, L${layers[X]} → L${layers[Y]}, ${sal}`;
+    if (idx.length < 2) {
+      return empty('Loss / gain', '', describe, 'Set the LAYERS slider to 2 or more layers.');
+    }
+    const loss = new Map<string, number>();
+    const gain = new Map<string, number>();
+    const seen = new Set<string>();
+    for (const [p, a] of sets[X]) {
+      const b = sets[Y].get(p);
+      if (!b) {
+        continue;
+      }
+      for (const w of a) {
+        seen.add(w);
+        if (!b.has(w)) {
+          loss.set(w, (loss.get(w) ?? 0) + 1);
+        }
+      }
+      for (const w of b) {
+        seen.add(w);
+        if (!a.has(w)) {
+          gain.set(w, (gain.get(w) ?? 0) + 1);
+        }
+      }
+    }
+    // The bar: the loss (or gain) count from L_X to each layer.
+    const toLayer = (w: string, li: number) => {
+      let c = 0;
+      for (const [p, a] of sets[X]) {
+        const b = sets[li].get(p);
+        if (b && (state.sortSecond ? !a.has(w) && b.has(w) : a.has(w) && !b.has(w))) {
+          c += 1;
+        }
+      }
+      return c;
+    };
+    const rows = [...seen].map((w) => {
+      const l = loss.get(w) ?? 0;
+      const g = gain.get(w) ?? 0;
+      return { key: w, token: w, value: state.sortSecond ? g : l, label: `${l} / ${g}`, stats: bars(layers, (li) => toLayer(w, li)) };
+    });
+    const barHeader = `${state.sortSecond ? 'Gain' : 'Loss'} from L${layers[X]}`;
+    return { rows: sortRows(rows), valueHeader: 'Loss / gain', barHeader, describe, note: null };
+  }
+
+  if (state.mode === 'positionLoss') {
+    const two = selected.length === 2;
+    const [A, B] = two ? (state.reverse ? [selected[1], selected[0]] : [selected[0], selected[1]]) : [selected[0], undefined];
+    const tokA = byPos.get(A);
+    const tokB = B == null ? undefined : byPos.get(B);
+    if (state.variant === 'one') {
+      const head = ['Rank', 'Loss by layer'] as const;
+      const layer = state.layer != null && layers.includes(state.layer) ? state.layer : layers[Y];
+      const li = layers.indexOf(layer);
+      const describe = two
+        ? `Position loss, 1 layer (L${layer}), position ${A} → ${B}, ${sal}`
+        : `Position loss, 1 layer (L${layer})`;
+      if (!two) {
+        return empty(...head, describe, 'Select 2 tokens.');
+      }
+      const start = salientAt(tokA, type, li, k);
+      const end = salientAt(tokB, type, li, k);
+      if (!start || !end) {
+        return empty(...head, describe, 'A selected token has no read at this layer in this column.');
+      }
+      const endSet = new Set(end);
+      const n = listLength(tokB, type, li);
+      const lossAt = (w: string, lj: number) => {
+        const a = salientAt(tokA, type, lj, k);
+        const b = salientAt(tokB, type, lj, k);
+        return a && b && a.includes(w) && !b.includes(w) ? 1 : 0;
+      };
+      const rows = start
+        .map((w, i) => ({ w, s: i + 1 }))
+        .filter(({ w }) => !endSet.has(w))
+        .map(({ w, s }) => {
+          const e = lookup.atLayer(layer, B!, w) ?? listRank(tokB, type, li, w);
+          return {
+            key: w,
+            token: w,
+            value: e ?? Number.MAX_SAFE_INTEGER,
+            label: `${s} → ${rankLabel(e, n)}`,
+            stats: bars(layers, (lj) => lossAt(w, lj)),
+            s,
+          };
+        })
+        .sort((a, b) => b.value - a.value || a.s - b.s)
+        .map(({ s: _s, ...row }) => row);
+      return { rows, valueHeader: head[0], barHeader: head[1], describe, note: null };
+    }
+    if (state.measure === 'salience') {
+      const describe = `Position loss, all layers, salience count at position ${A ?? '?'}, L${layers[X]} to L${layers[Y]}, ${sal}`;
+      if (A == null || selected.length > 2) {
+        return empty('Salient / not', 'Salient by layer', describe, 'Select 1 token (or 2: the first is used).');
+      }
+      const count = new Map<string, number>();
+      let valid = 0;
+      for (const li of idx) {
+        const s = salientAt(tokA, type, li, k);
+        if (!s) {
+          continue;
+        }
+        valid += 1;
+        for (const w of s) {
+          count.set(w, (count.get(w) ?? 0) + 1);
+        }
+      }
+      const rows = [...count.entries()].map(([w, c]) => ({
+        key: w,
+        token: w,
+        value: state.sortSecond ? valid - c : c,
+        label: `${c} / ${valid - c}`,
+        stats: bars(layers, (li) => (salientAt(tokA, type, li, k)?.includes(w) ? 1 : 0)),
+      }));
+      return { rows: sortRows(rows), valueHeader: 'Salient / not', barHeader: 'Salient by layer', describe, note: null };
+    }
+    const describe = two
+      ? `Position loss, all layers, loss and gain, position ${A} → ${B}, L${layers[X]} to L${layers[Y]}, ${sal}`
+      : 'Position loss, all layers, loss and gain';
+    if (!two) {
+      return empty('Loss / gain', '', describe, 'Select 2 tokens.');
+    }
+    const loss = new Map<string, number>();
+    const gain = new Map<string, number>();
+    const seen = new Set<string>();
+    const event = new Map<string, number[]>();
+    for (const li of idx) {
+      const a = salientAt(tokA, type, li, k);
+      const b = salientAt(tokB, type, li, k);
+      if (!a || !b) {
+        continue;
+      }
+      for (const w of a) {
+        seen.add(w);
+        if (!b.includes(w)) {
+          loss.set(w, (loss.get(w) ?? 0) + 1);
+          if (!state.sortSecond) {
+            event.set(w, [...(event.get(w) ?? []), li]);
+          }
+        }
+      }
+      for (const w of b) {
+        seen.add(w);
+        if (!a.includes(w)) {
+          gain.set(w, (gain.get(w) ?? 0) + 1);
+          if (state.sortSecond) {
+            event.set(w, [...(event.get(w) ?? []), li]);
+          }
+        }
+      }
+    }
+    const rows = [...seen].map((w) => {
+      const l = loss.get(w) ?? 0;
+      const g = gain.get(w) ?? 0;
+      const at = new Set(event.get(w) ?? []);
+      return { key: w, token: w, value: state.sortSecond ? g : l, label: `${l} / ${g}`, stats: bars(layers, (li) => (at.has(li) ? 1 : 0)) };
+    });
+    return { rows: sortRows(rows), valueHeader: 'Loss / gain', barHeader: state.sortSecond ? 'Gain by layer' : 'Loss by layer', describe, note: null };
+  }
+
+  if (state.mode === 'smear') {
+    const m = Math.max(1, state.m);
+    const head = ['Run', 'Salient by layer'] as const;
+    if (selected.length !== 1) {
+      return empty(...head, `Smear, ${m} or more layers`, 'Select 1 token.');
+    }
+    const tok = byPos.get(selected[0]);
+    const describe = `Smear at position ${selected[0]}, ${m} or more contiguous read layers in L${layers[X]} to L${layers[Y]}, ${sal}`;
+    const cur = new Map<string, number>();
+    const best = new Map<string, { run: number; last: number }>();
+    for (const li of idx) {
+      const s = new Set(salientAt(tok, type, li, k) ?? []);
+      for (const w of [...cur.keys()]) {
+        if (!s.has(w)) {
+          cur.delete(w);
+        }
+      }
+      for (const w of s) {
+        const c = (cur.get(w) ?? 0) + 1;
+        cur.set(w, c);
+        if (c > (best.get(w)?.run ?? 0)) {
+          best.set(w, { run: c, last: li });
+        }
+      }
+    }
+    const rows = [...best.entries()]
+      .filter(([, b]) => b.run >= m)
+      .map(([w, b]) => {
+        const first = idx[idx.indexOf(b.last) - b.run + 1];
+        return {
+          key: w,
+          token: w,
+          value: b.run,
+          label: `${b.run}: L${layers[first]}–${layers[b.last]}`,
+          stats: bars(layers, (li) => (salientAt(tok, type, li, k)?.includes(w) ? 1 : 0)),
+          first,
+        };
+      })
+      .sort((a, b) => b.value - a.value || a.first - b.first || (a.key < b.key ? -1 : 1))
+      .map(({ first: _f, ...row }) => row);
+    return { rows, valueHeader: head[0], barHeader: head[1], describe, note: null };
+  }
+
+  return empty('', '', '', 'No instrument.');
+}
+
+// The instrument list in the shape of the sidebar list.
+export function instrumentSidebar(out: InstrumentOutput): TypeSidebar {
+  const items: CommonToken[] = out.rows.map((r) => ({ key: r.key, token: r.token, count: r.value, label: r.label }));
+  return {
+    items,
+    allItems: items,
+    countByKey: new Map(out.rows.map((r) => [r.key, r.value] as const)),
+    canonicalOf: new Map(out.rows.map((r) => [r.key, r.key] as const)),
+    layerStatsByKey: new Map(out.rows.map((r) => [r.key, r.stats] as const)),
+  };
+}
