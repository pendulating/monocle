+import { LensTokenMessage } from '@/lib/utils/lens';
+import { describe, expect, it } from 'vitest';
+import golden from './jlens-instruments.golden.json';
+import {
+  computeInstrument,
+  DEFAULT_INSTRUMENT,
+  instrumentSidebar,
+  InstrumentState,
+  parseInstrumentBlock,
+} from './jlens-instruments';
+
+// The fixture holds a small run and the output of the Python core (monocle
+// `research/monocle/instruments.py`) for each case.
+type Case = {
+  type: string;
+  range: [number, number];
+  selected: number[];
+  state: Partial<InstrumentState>;
+  ordered: boolean;
+  rows: (string | number)[][];
+};
+
+const run = golden.run as unknown as {
+  tokens: LensTokenMessage[];
+  meta: { layers_by_type: Record<string, number[]> };
+  instruments: unknown;
+};
+const cases = golden.cases as unknown as Case[];
+const block = parseInstrumentBlock(run.instruments);
+
+function compute(c: Case, withBlock = true) {
+  return computeInstrument({
+    tokens: run.tokens,
+    type: c.type,
+    layers: run.meta.layers_by_type[c.type],
+    range: c.range,
+    selected: c.selected,
+    block: withBlock ? block : null,
+    state: { ...DEFAULT_INSTRUMENT, ...c.state },
+  });
+}
+
+describe('the instruments agree with the Python core', () => {
+  it('reads the rank block of the fixture', () => {
+    expect(block).not.toBeNull();
+    expect(cases.length).toBeGreaterThan(50);
+  });
+
+  cases.forEach((c, i) => {
+    const name = `${i}: ${c.type} ${JSON.stringify(c.state)} ${JSON.stringify(c.selected)} ${c.range.join('-')}`;
+    it(name, () => {
+      const got = compute(c).rows.map((r) => [r.key, r.label]);
+      const want = c.rows.map((r) => [r[0], r[1]]);
+      if (c.ordered) {
+        expect(got).toEqual(want);
+      } else {
+        const order = (a: (string | number)[], b: (string | number)[]) => String(a[0]).localeCompare(String(b[0]));
+        expect([...got].sort(order)).toEqual([...want].sort(order));
+      }
+    });
+  });
+});
+
+describe('the instruments with no rank block', () => {
+  it('give >30 for an end rank past the top list, and the same words', () => {
+    let checked = 0;
+    for (const c of cases.filter((x) => x.state.variant === 'one')) {
+      const got = new Map(compute(c, false).rows.map((r) => [r.key, r.label] as const));
+      expect([...got.keys()].sort()).toEqual(c.rows.map((r) => String(r[0])).sort());
+      for (const [word, label, end] of c.rows) {
+        const start = String(label).split(' → ')[0];
+        expect(got.get(String(word))).toBe(Number(end) > 30 ? `${start} → >30` : String(label));
+        checked += 1;
+      }
+    }
+    expect(checked).toBeGreaterThan(20);
+  });
+});
+
+describe('the parts around the lists', () => {
+  it('asks for a selection when it is missing', () => {
+    const c = cases.find((x) => x.state.mode === 'smear')!;
+    const out = compute({ ...c, selected: [] });
+    expect(out.rows).toEqual([]);
+    expect(out.note).toBe('Select 1 token.');
+  });
+
+  it('refuses a bad block', () => {
+    expect(parseInstrumentBlock(undefined)).toBeNull();
+    expect(parseInstrumentBlock({ unit: 'z', columns: {} })).toBeNull();
+    expect(parseInstrumentBlock({ unit: 'rank', columns: { X: { words: 1 } } })).toBeNull();
+  });
+
+  it('makes a sidebar list with the label and the bars', () => {
+    const c = cases.find((x) => x.state.mode === 'layerLoss' && x.state.variant === 'one' && x.rows.length > 0)!;
+    const out = compute(c);
+    const side = instrumentSidebar(out);
+    expect(side.items[0].label).toBe(out.rows[0].label);
+    expect(side.layerStatsByKey.get(out.rows[0].key)).toHaveLength(run.meta.layers_by_type[c.type].length);
+  });
+});
