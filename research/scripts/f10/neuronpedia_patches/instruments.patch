diff --git a/apps/webapp/components/jlens/jlens-instruments-bar.tsx b/apps/webapp/components/jlens/jlens-instruments-bar.tsx
new file mode 100644
index 0000000..a16eff5
--- /dev/null
+++ b/apps/webapp/components/jlens/jlens-instruments-bar.tsx
@@ -0,0 +1,122 @@
+'use client';
+
+// The controls of the readout instruments (monocle F10.35). The lists come from
+// `jlens-instruments.ts`; the word list of the panel shows them.
+
+import { InstrumentMode, InstrumentState } from './jlens-instruments';
+import type { JlensAnalysis } from './use-jlens-analysis';
+
+const MODES: { mode: InstrumentMode; label: string }[] = [
+  { mode: 'count', label: 'Count' },
+  { mode: 'layerLoss', label: 'Layer loss' },
+  { mode: 'positionLoss', label: 'Position loss' },
+  { mode: 'smear', label: 'Smear' },
+];
+
+function Toggle({ on, label, onClick, title }: { on: boolean; label: string; onClick: () => void; title?: string }) {
+  return (
+    <button
+      type="button"
+      title={title}
+      onClick={onClick}
+      className={`rounded border px-1.5 py-0.5 text-[10px] leading-none transition-colors ${
+        on ? 'border-slate-500 bg-slate-600 text-white' : 'border-slate-300 bg-white text-slate-500 hover:bg-slate-100'
+      }`}
+    >
+      {label}
+    </button>
+  );
+}
+
+export function JlensInstrumentBar({ analysis }: { analysis: JlensAnalysis }) {
+  const { instrument: s, setInstrument, instrumentOutputs, sidebarTypes, layersByType, hasInstrumentBlock } = analysis;
+  const set = (patch: Partial<InstrumentState>) => setInstrument((cur) => ({ ...cur, ...patch }));
+  const first = instrumentOutputs ? instrumentOutputs[sidebarTypes[0]] : null;
+  const layers = layersByType[sidebarTypes[0]] ?? [];
+  const isLoss = s.mode === 'layerLoss' || s.mode === 'positionLoss';
+  const unit = s.mode === 'layerLoss' ? 'token' : 'layer';
+  const sortLabels = s.measure === 'salience' ? ['salient', 'not salient'] : ['loss', 'gain'];
+  const notes = instrumentOutputs ? [...new Set(Object.values(instrumentOutputs).map((o) => o.note).filter(Boolean))] : [];
+  return (
+    <div className="flex flex-col gap-y-1 px-2.5 pt-2 text-[10px] text-slate-500 sm:px-4">
+      <div className="flex flex-row flex-wrap items-center gap-1">
+        <span className="mr-0.5 font-medium uppercase tracking-wide text-slate-400">Instrument</span>
+        {MODES.map((m) => (
+          <Toggle key={m.mode} on={s.mode === m.mode} label={m.label} onClick={() => set({ mode: m.mode })} />
+        ))}
+      </div>
+      {s.mode !== 'count' && (
+        <div className="flex flex-row flex-wrap items-center gap-1">
+          {isLoss && (
+            <>
+              <Toggle on={s.variant === 'one'} label={`1 ${unit}`} onClick={() => set({ variant: 'one' })} />
+              <Toggle on={s.variant === 'all'} label={`All ${unit}s`} onClick={() => set({ variant: 'all' })} />
+            </>
+          )}
+          {isLoss && s.variant === 'all' && (
+            <>
+              <span className="mx-1 text-slate-300">|</span>
+              <Toggle on={s.measure === 'salience'} label="Salience count" onClick={() => set({ measure: 'salience' })} />
+              <Toggle on={s.measure === 'lossGain'} label="Loss and gain" onClick={() => set({ measure: 'lossGain' })} />
+              <span className="mx-1 text-slate-300">|</span>
+              <span>Sort by</span>
+              <Toggle on={!s.sortSecond} label={sortLabels[0]} onClick={() => set({ sortSecond: false })} />
+              <Toggle on={s.sortSecond} label={sortLabels[1]} onClick={() => set({ sortSecond: true })} />
+            </>
+          )}
+          {s.mode === 'positionLoss' && (
+            <>
+              <span className="mx-1 text-slate-300">|</span>
+              <Toggle
+                on={s.reverse}
+                label="Reverse A ↔ B"
+                title="Go from the later token to the earlier token"
+                onClick={() => set({ reverse: !s.reverse })}
+              />
+            </>
+          )}
+          {s.mode === 'positionLoss' && s.variant === 'one' && (
+            <label className="ml-1 flex flex-row items-center gap-x-1">
+              Layer
+              <select
+                className="rounded border border-slate-300 bg-white px-1 py-0 text-[10px]"
+                value={s.layer ?? ''}
+                onChange={(e) => set({ layer: e.target.value === '' ? null : Number(e.target.value) })}
+              >
+                <option value="">last in range</option>
+                {layers.map((l) => (
+                  <option key={l} value={l}>
+                    L{l}
+                  </option>
+                ))}
+              </select>
+            </label>
+          )}
+          {s.mode === 'smear' && (
+            <label className="flex flex-row items-center gap-x-1">
+              Shortest run
+              <input
+                type="number"
+                min={1}
+                max={layers.length || 1}
+                value={s.m}
+                onChange={(e) => set({ m: Math.max(1, Number(e.target.value) || 1) })}
+                className="w-10 rounded border border-slate-300 bg-white px-1 py-0 text-[10px]"
+              />
+              layers
+            </label>
+          )}
+        </div>
+      )}
+      {first && <div className="leading-snug text-slate-600">{first.describe}</div>}
+      {notes.map((n) => (
+        <div key={n} className="rounded border border-amber-200 bg-amber-50 px-2 py-0.5 leading-snug text-amber-700">
+          {n}
+        </div>
+      ))}
+      {first && !hasInstrumentBlock && (s.variant === 'one' || s.mode === 'smear') && s.mode !== 'smear' && (
+        <div className="leading-snug text-slate-400">This run has no rank block: a rank past the top list shows as &gt;30.</div>
+      )}
+    </div>
+  );
+}
