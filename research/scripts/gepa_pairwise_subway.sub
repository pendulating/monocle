#!/bin/bash
#SBATCH --job-name=gepa-pairwise-subway
#SBATCH --partition=pierson
#SBATCH --nodelist=klara
#SBATCH --gres=gpu:1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=08:00:00
#SBATCH --output=/share/ju/matt/mllmsci/logs/gepa_pairwise_subway-%j.out
#SBATCH --error=/share/ju/matt/mllmsci/logs/gepa_pairwise_subway-%j.err

# GEPA prompt optimization over the subway-safety pairwise task.
# gemma-4-12b (gemma4_unified) is both task model and reflection model, so
# this runs on the site venv .venv-vllm025cu129 (vLLM 0.25, gepa) with the
# klara libstdc++ LD_PRELOAD, as slurm_gpu_klara_1x.
#
# Submit from the repo root:
#   sbatch research/scripts/gepa_pairwise_subway.sub [extra gepa_pairwise args...]

set -euo pipefail
cd /share/ju/matt/mllmsci

source ~/.bashrc
source /share/ju/matt/mllmsci/.venv-vllm025cu129/bin/activate
# bashrc conda-activates anaconda base, whose old libstdc++.so.6 lacks
# GLIBCXX_3.4.32 (needed by flashinfer JIT); force the system one.
export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libstdc++.so.6
export PYTHONUNBUFFERED=1

echo "=== GPU sanity ==="
echo "HOST=$(hostname) DATE=$(date) CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi -L || true

python -m research.prompt_opt.pairwise.gepa_pairwise "$@"
