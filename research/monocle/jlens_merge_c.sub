#!/bin/bash
#SBATCH --job-name=jlensCmerge
#SBATCH --partition=pierson
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=/share/ju/matt/mllmsci/outputs/jlensCmerge_%j.out
# Merge the fit C shards (full, even half, odd half) on a CPU node and verify
# each lens. The login node killed this merge for memory. Usage:
#   sbatch research/monocle/jlens_merge_c.sub [dir ...]
set -euo pipefail
cd /share/ju/matt/mllmsci
export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libstdc++.so.6
PY=.venv-nightly/bin/python
DIRS=("$@")
if [ ${#DIRS[@]} -eq 0 ]; then
  DIRS=(outputs/_monocle/jlens/mm_textafter
        outputs/_monocle/jlens/mm_textafter/half_even
        outputs/_monocle/jlens/mm_textafter/half_odd)
fi
for D in "${DIRS[@]}"; do
  echo "=== merge $D"
  "$PY" -m research.monocle.jlens_merge_mm --in-dir "$D" --out "$D/gemma4_12b_lens.pt" --final-only
  echo "=== verify $D"
  "$PY" research/scripts/jlens_verify_lens.py "$D/gemma4_12b_lens.pt" 47
done
echo "ALL C MERGES DONE"
