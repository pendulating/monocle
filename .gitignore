celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
# uv writes a `.gitignore` with `*` inside each venv it makes, so `.venv-*`
# directories exclude themselves. The bootstrap tarballs do NOT — they are
# multi-GB files that scripts/sync_venv_to_scratch.sh --make-tarball writes
# beside the venvs. Keep them out of the repository.
.venv-mirrors/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

