#!/bin/bash
#SBATCH -J trashbot-viewer
#SBATCH --output=/share/pierson/matt/mllmsci/.slurm_jobs/trashbot-viewer/%j.out
#SBATCH --error=/share/pierson/matt/mllmsci/.slurm_jobs/trashbot-viewer/%j.err
#SBATCH --mail-type=ALL
#SBATCH --mail-user=mwf62@cornell.edu
#SBATCH -N 1
#SBATCH -n 4
#SBATCH --mem=16G
#SBATCH -t 240:00:00
#SBATCH --partition=pierson

# Serve the TrashBot footage viewer on port 8925.
# Tunnel first: ssh -L 8925:<node-hostname>:8925 <login-host>

cd /share/pierson/matt/mllmsci/tools/trashbot_annotator || exit 1
source .venv/bin/activate

# The zoo ffmpeg needs its own shared libraries on the loader path.
export PATH="/share/pierson/matt/zoo/ffmpeg-libs/n7.1/bin:$PATH"
export LD_LIBRARY_PATH="/share/pierson/matt/zoo/ffmpeg-libs/n7.1/lib:${LD_LIBRARY_PATH:-}"

echo "node: $(hostname)"
echo "ffmpeg: $(command -v ffmpeg)"
ffmpeg -version 2>/dev/null | head -1

exec marimo edit viewer.py --headless --no-token --host 0.0.0.0 --port 8925
