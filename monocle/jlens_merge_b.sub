#!/bin/bash
#SBATCH --job-name=jlensBmerge
#SBATCH --partition=pierson
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=48G
#SBATCH --time=01:00:00
#SBATCH --output=/share/ju/matt/mllmsci/outputs/jlensBmerge_%j.out
# Merge the 16 fit B shards (1,000 WikiText prompts, 8 layers) on a CPU
# node, then verify the lens. Usage: sbatch monocle/jlens_merge_b.sub
set -euo pipefail
cd /share/ju/matt/mllmsci
export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libstdc++.so.6
PY=.venv-nightly/bin/python
D=outputs/_monocle/jlens/wikitext1k
echo "=== merge $D"
"$PY" -m monocle.jlens_fit --merge "$D"/shard*of16.pt --out-dir "$D"
echo "=== verify $D"
"$PY" scripts/jlens_verify_lens.py "$D/gemma4_12b_lens.pt" 8
echo "B MERGE DONE"
