#!/bin/bash
#SBATCH --job-name=nli-classify
#SBATCH --partition=ju
#SBATCH --gres=gpu:4               # Using 4 GPUs for parallelization
#SBATCH --cpus-per-task=4         # Increased CPUs for parallel workers
#SBATCH --mem=64G                  # Increased memory for parallel processes
#SBATCH --time=24:00:00
#SBATCH --output=/share/pierson/matt/mllmsci/.slurm_jobs/nli-classify/%j.out
#SBATCH --error=/share/pierson/matt/mllmsci/.slurm_jobs/nli-classify/%j.err

set -euo pipefail

echo "=== NLI Classification for VQA Responses ==="
date
echo ""

# ----------------------------- CONFIGURATION ----------------------------- #
REPO_DIR="/share/pierson/matt/mllmsci"
INPUT_FILE="${INPUT_FILE:-}"      # Path to input parquet file (required)
OUTPUT_FILE="${OUTPUT_FILE:-}"    # Path to output parquet file (required)
BATCH_SIZE="${BATCH_SIZE:-16}"    # Batch size for classification
NUM_WORKERS="${NUM_WORKERS:-4}"    # Number of parallel workers (matches GPU count)
MODEL="${MODEL:-facebook/bart-large-mnli}"  # HuggingFace model to use
LIMIT="${LIMIT:-}"                # Optional: limit number of rows for testing
HF_HOME="${HF_HOME:-/share/pierson/matt/.cache/huggingface}"
LOG_DIR="${LOG_DIR:-$REPO_DIR/logs/nli-classify}"

mkdir -p "$LOG_DIR"
mkdir -p "$HF_HOME"

echo "Repository      : $REPO_DIR"
echo "Input file      : $INPUT_FILE"
echo "Output file     : $OUTPUT_FILE"
echo "Batch size      : $BATCH_SIZE"
echo "Num workers     : $NUM_WORKERS"
echo "Model           : $MODEL"
echo "HF cache        : $HF_HOME"
if [ -n "$LIMIT" ]; then
    echo "Row limit       : $LIMIT"
fi
echo ""

# Validate required parameters
if [ -z "$INPUT_FILE" ]; then
    echo "ERROR: INPUT_FILE environment variable must be set." >&2
    echo "Example: sbatch --export=INPUT_FILE=/path/to/input.parquet,OUTPUT_FILE=/path/to/output.parquet $0" >&2
    exit 1
fi

if [ -z "$OUTPUT_FILE" ]; then
    echo "ERROR: OUTPUT_FILE environment variable must be set." >&2
    echo "Example: sbatch --export=INPUT_FILE=/path/to/input.parquet,OUTPUT_FILE=/path/to/output.parquet $0" >&2
    exit 1
fi

# ------------------------------ ENVIRONMENT ------------------------------ #
cd "$REPO_DIR"
pwd

if [ ! -d ".venv" ]; then
    echo "ERROR: .venv not found. Create the uv virtualenv before submitting this job." >&2
    exit 1
fi

# Activate venv before running any Python
source .venv/bin/activate
echo "Python: $(which python)"
echo "Python version: $(python --version)"

# ------------------------------ SET UP CUDA ENVIRONMENT ------------------------------ #
export HF_HOME
export WANDB_MODE=disabled          # Disable W&B for this job
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:64,expandable_segments:True
export CUDA_LAUNCH_BLOCKING=0

# Respect Slurm's per-step GPU mapping if present
# Set CUDA_VISIBLE_DEVICES BEFORE GPU sanity checks
if [ -z "${CUDA_VISIBLE_DEVICES:-}" ]; then
    if [ -n "${SLURM_STEP_GPUS:-}" ]; then
        export CUDA_VISIBLE_DEVICES="${SLURM_STEP_GPUS}"
    elif [ -n "${SLURM_JOB_GPUS:-}" ]; then
        if [[ "${SLURM_JOB_GPUS}" =~ ^[0-9]+(,[0-9]+)*$ ]]; then
            export CUDA_VISIBLE_DEVICES="${SLURM_JOB_GPUS}"
        else
            echo "WARNING: Ignoring SLURM_JOB_GPUS='${SLURM_JOB_GPUS}' (not CUDA indices)" >&2
        fi
    fi
fi

echo "SLURM_JOB_GPUS=${SLURM_JOB_GPUS:-<unset>}"
echo "SLURM_STEP_GPUS=${SLURM_STEP_GPUS:-<unset>}"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-<unset>}"

# ------------------------------ GPU SANITY ------------------------------- #
if ! command -v nvidia-smi >/dev/null 2>&1; then
    echo "ERROR: nvidia-smi not found. Ensure this job runs on a GPU node." >&2
    exit 1
fi

echo "=== GPU sanity (pre-job) ==="
echo "HOST=$(hostname) DATE=$(date)"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-<unset>} SLURM_JOB_GPUS=${SLURM_JOB_GPUS:-<unset>} SLURM_STEP_GPUS=${SLURM_STEP_GPUS:-<unset>} SLURM_GPUS_ON_NODE=${SLURM_GPUS_ON_NODE:-<unset>}"

nvidia-smi
nvidia-smi topo -m || true

# Now safe to run Python checks (using venv Python)
# Make this check handle errors gracefully
python -c 'import torch; print("torch.cuda.is_available=", torch.cuda.is_available()); print("torch.cuda.device_count=", torch.cuda.device_count()); [print(f"torch device {i}=", torch.cuda.get_device_name(i)) for i in range(torch.cuda.device_count())]' || true

# ------------------------------ RUN NLI CLASSIFICATION ------------------------------ #

echo ""
echo "Starting NLI classification..."
echo ""

# Build command arguments
CMD_ARGS=(
    "$REPO_DIR/scripts/optimize_prompts_nli.py"
    --input "$INPUT_FILE"
    --output "$OUTPUT_FILE"
    --batch_size "$BATCH_SIZE"
    --num_workers "$NUM_WORKERS"
    --model "$MODEL"
)

if [ -n "$LIMIT" ]; then
    CMD_ARGS+=(--limit "$LIMIT")
fi

echo "Command line:"
echo "  python ${CMD_ARGS[*]}"
echo ""

# Run the script
python "${CMD_ARGS[@]}"

EXIT_CODE=$?

echo ""
if [ $EXIT_CODE -eq 0 ]; then
    echo "NLI classification completed successfully at $(date)"
else
    echo "NLI classification failed with exit code $EXIT_CODE at $(date)" >&2
    exit $EXIT_CODE
fi

