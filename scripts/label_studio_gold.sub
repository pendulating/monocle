#!/bin/bash
#SBATCH -J cues-label
#SBATCH -o /share/ju/matt/mllmsci/data/label_studio/logs/%j.out
#SBATCH -e /share/ju/matt/mllmsci/data/label_studio/logs/%j.err
#SBATCH -N 1 -n 1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH -t 7-00:00:00
#SBATCH --partition=pierson-interactive
#SBATCH --nodelist=lisbeth
# A long-lived web app for a human, so it runs on the group's own node rather
# than a slot in the shared partitions. Follows
# /share/ju/tiktok/glasses_search/slurm/label_studio.sub.
#
#   sbatch scripts/label_studio_gold.sub [port]      # default 8925
#   tail -30 data/label_studio/logs/<jobid>.out      # read the tunnel command out of the log
#
# Pass the port as an ARGUMENT: the submitting shell's environment is not
# forwarded to the job on this cluster.
#
# NOT --requeue: a requeued job lands on another node, which silently changes
# the host the tunnel points at. Better to fail visibly.
#
# The SQLite db lives on NFS under data/label_studio/data, thus every project,
# task, and annotation survives a move between nodes; only the tunnel target
# changes.
set -uo pipefail
REPO=/share/ju/matt/mllmsci
mkdir -p "$REPO/data/label_studio/logs"
export PORT="${1:-${PORT:-8925}}"
echo "=== $(date) host=$(hostname -f) job=${SLURM_JOB_ID:-none} ==="
exec bash "$REPO/scripts/label_studio_gold.sh"
