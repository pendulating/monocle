#!/bin/bash
#SBATCH --job-name=gepa-probe
#SBATCH --partition=pierson
#SBATCH --nodelist=klara
#SBATCH --gres=gpu:1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --output=outputs/gepa_pairwise/slurm_%j.out

# Direct task-inference probe + axis-ceiling evals (no GEPA search).
# Same environment recipe as scripts/gepa_pairwise_subway.sub.
#
# Submit from the repo root:
#   sbatch scripts/gepa_probe.sub [extra task_inference_probe args...]

set -euo pipefail
cd /share/pierson/matt/mllmsci

source ~/.bashrc
source /share/pierson/matt/mllmsci/.venv-nightly/bin/activate
export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libstdc++.so.6
export PYTHONUNBUFFERED=1

echo "=== GPU sanity ==="
echo "HOST=$(hostname) DATE=$(date) CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi -L || true

python -m dagspaces.urbanpairvqa.prompt_opt.task_inference_probe "$@"
