# Site settings. Copy this file to server.env and set the values for your cluster.
#
# ensure_dotenv() loads server.env before Hydra composes a config, and again in
# each stage job. scripts/load_server_env.sh loads it in the job shell. A variable
# that the shell already sets is not overwritten. Write KEY=value; $VAR is not expanded.
# IMAGE_FORWARD_SERVER_ENV can name a different file. Put API keys in .env, not here.
#
# Each key is optional, unless the comment says that it is necessary.

# -- SLURM -----------------------------------------------------------------------
# The generic launchers (dagspaces/common/conf/hydra/launcher/) read these keys.
# A key that is not set gives no sbatch option, so SLURM uses the cluster default.
# Note: do not use the names SLURM_PARTITION and so on. The CLI removes each
# SLURM* variable before a launch, and SLURM sets SLURM_PARTITION in each job.
IMAGE_FORWARD_SLURM_PARTITION=gpu
# IMAGE_FORWARD_SLURM_ACCOUNT=my-account
# IMAGE_FORWARD_SLURM_QOS=normal
# IMAGE_FORWARD_SLURM_CONSTRAINT=a100
# IMAGE_FORWARD_SLURM_EXCLUDE=node01,node02

# The folder of sbatch and srun, when a compute node does not have it on PATH.
# IMAGE_FORWARD_SLURM_BIN=/usr/local/slurm/bin

# The first part of each stage job name: <prefix>-<job>. The default is $USER.
# IMAGE_FORWARD_JOB_PREFIX=myname

# A shell script that each job sources first: module loads, a conda fix, an
# LD_PRELOAD. Use it for a setting that your cluster needs and others do not.
# IMAGE_FORWARD_SITE_SETUP=/path/to/site_setup.sh

# -- Paths -----------------------------------------------------------------------
# The repo root. The default is the folder that holds this file.
# IMAGE_FORWARD_PROJECT_ROOT=/path/to/repo

# The activate script of the venv. Necessary on a cluster: each job sources it.
IMAGE_FORWARD_VENV_ACTIVATE=/path/to/repo/.venv/bin/activate

# A folder of local model weights. A model config can write
# model_source: ${oc.env:IMAGE_FORWARD_MODEL_ZOO}/<name>
# IMAGE_FORWARD_MODEL_ZOO=/path/to/models
# The zoo folders that scripts/sync_model_registry_to_scratch.sh mirrors to
# each node, with a space between them.
# IMAGE_FORWARD_MIRROR_MODELS="Qwen2.5-VL-3B-Instruct"

# A node-local mirror of the model folder (see docs/models-and-mirrors.md).
# IMAGE_FORWARD_MODEL_REGISTRY=/scratch/myname/registry/models

# The CUDA toolkit and the FFmpeg libraries, when the system has no usable copy.
# scripts/activate_stage_venv.sh uses them. When a key is not set, the job uses the copy of the node.
# IMAGE_FORWARD_CUDA_HOME=/usr/local/cuda
# IMAGE_FORWARD_FFMPEG_LIBDIR=/path/to/ffmpeg/lib

# -- Caches ----------------------------------------------------------------------
# HF_HOME=/path/to/cache/huggingface
# VLLM_CACHE_ROOT=/path/to/cache/vllm

# -- Weights & Biases ------------------------------------------------------------
# W&B logs only when WANDB_ENTITY (or the config key wandb.entity) is set.
# WANDB_ENTITY=my-team
# WANDB_PROJECT=my-project

# -- NCCL (GPU interconnect) -----------------------------------------------------
# Set these to 1 on a PCIe-only node (no NVLink). Remove them on an NVLink or IB cluster.
NCCL_P2P_DISABLE=1
NCCL_IB_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_CUMEM_HOST_ENABLE=0

# -- Tuning (optional) -----------------------------------------------------------
# IMAGE_FORWARD_TENSOR_PARALLEL_SIZE=2      # override the tensor-parallel size of each stage
# IMAGE_FORWARD_LOG_LEVEL=INFO
# IMAGE_FORWARD_VLLM_LOG_EVERY=10           # print 1 of N vLLM batch-time lines
# IMAGE_FORWARD_SKIP_SCRATCH_VENV=1         # do not use a /scratch venv mirror
